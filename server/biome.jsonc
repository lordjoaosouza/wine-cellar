{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "prisma/**/*.ts",
      "!src/generated"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noVoid": "off"
      },
      "performance": {
        "noAwaitInLoops": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/middleware/auth.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    }
  ]
}
