PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

DATABASE_URL=postgresql://wine_cellar:wine_cellar@localhost:5432/wine_cellar

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ENCRYPTION_KEY=

RESEND_API_KEY=
EMAIL_FROM="Wine Cellar <login@yourdomain.com>"

# Where label and tasting photos are stored (relative to the server directory).
UPLOADS_DIR=uploads

# Local AI: Ollama with a multimodal model (research + label reading), and
# SearXNG for web search. In Docker these are set by docker-compose.yml.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
LLM_CONTEXT_TOKENS=8192
SEARXNG_URL=http://localhost:8888
